# 이 파일을 .env로 복사해 로컬 환경에 맞춰 값을 채울 수 있습니다.
# .env에는 비밀번호를 포함하므로 Git에 커밋하지 않습니다.

OTBOO_SERVER_PORT=8080

# 의상 이미지 S3 설정
OTBOO_AWS_REGION=ap-northeast-2
# LocalStack나 S3Mock을 사용하는 로컬 환경에서만 endpoint를 지정합니다.
OTBOO_AWS_ENDPOINT=
OTBOO_CLOTHES_S3_BUCKET=
# 비공개 S3는 CloudFront OAC와 연결한 뒤 배포 도메인을 지정합니다.
OTBOO_CLOTHES_IMAGE_PUBLIC_BASE_URL=
OTBOO_CLOTHES_S3_API_CALL_TIMEOUT=10s
OTBOO_CLOTHES_S3_API_CALL_ATTEMPT_TIMEOUT=5s

# KAKAO REST API Key
KAKAO_REST_API_KEY=

# JWT 인증
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=3600000

OTBOO_DB_HOST=localhost
# 다른 checkout 또는 기존 DB와 동시에 실행할 때는 사용하지 않는 포트로 변경합니다.
OTBOO_DB_PORT=5432
OTBOO_DB_NAME=otboo
OTBOO_DB_USERNAME=otboo
OTBOO_DB_PASSWORD=change-me

OTBOO_JPA_DDL_AUTO=validate
OTBOO_JPA_FORMAT_SQL=true
OTBOO_JPA_SHOW_SQL=false
OTBOO_FLYWAY_ENABLED=true
