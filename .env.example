# .env 에는 실제 비밀번호 같은 개인 설정이 들어가므로 Git에 올리지 않습니다.

OTBOO_AWS_REGION=ap-northeast-2
OTBOO_AWS_ENDPOINT=
OTBOO_CLOTHES_S3_BUCKET=replace-with-s3-bucket-name
OTBOO_CLOTHES_IMAGE_PUBLIC_BASE_URL=https://replace-with-cdn-domain
OTBOO_CLOTHES_S3_API_CALL_TIMEOUT=10s
OTBOO_CLOTHES_S3_API_CALL_ATTEMPT_TIMEOUT=5s
